{
  "name": "Blip",
  "short_name": "Blip",
  "description": "Say it. Get it done.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F8FAF7",
  "theme_color": "#1B3B2B",
  "icons": [
    {
      "src": "icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "New voice task",
      "short_name": "Voice task",
      "description": "Say a task and Blip adds it",
      "url": "./?go=voice",
      "icons": [
        {
          "src": "icons/shortcuts/voice-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcuts/voice-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "Plan tomorrow",
      "short_name": "Plan tomorrow",
      "description": "Speak, and it all goes on tomorrow",
      "url": "./?go=tomorrow",
      "icons": [
        {
          "src": "icons/shortcuts/tomorrow-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcuts/tomorrow-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "Summarize today",
      "short_name": "Summarize",
      "description": "See how your day is going",
      "url": "./?go=summary",
      "icons": [
        {
          "src": "icons/shortcuts/summary-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcuts/summary-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    },
    {
      "name": "New note",
      "short_name": "New note",
      "description": "Dictate a note",
      "url": "./?go=note",
      "icons": [
        {
          "src": "icons/shortcuts/note-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcuts/note-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable"
        }
      ]
    }
  ]
}
